{
  "name": "derpbird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "bun test ./tests/*.test.ts",
    "build:engine": "python3 scripts/workflow.py build",
    "test:ui:dom": "bun run build && bun scripts/check-ui.ts",
    "prepare:engine": "bun run build && python3 scripts/prepare-engine.py",
    "start": "python3 scripts/run.py",
    "test:overlay": "python3 -m unittest discover -s tests/build -v",
    "test:native:unit": "python3 scripts/workflow.py native",
    "test:native:engine": "python3 scripts/workflow.py native --engine",
    "test:split:engine": "python3 scripts/test-split-view.py",
    "test:shell:engine": "python3 scripts/test-native-regressions.py --suite TestDerpBirdShell",
    "test:styles:engine": "python3 scripts/workflow.py styles",
    "test:native:regressions": "python3 scripts/test-native-regressions.py",
    "test:styles:bundle": "bun run build && bun scripts/test-style-worker.ts",
    "doctor": "python3 scripts/workflow.py doctor",
    "build:engine:all": "python3 scripts/workflow.py build all",
    "test:fast": "python3 scripts/workflow.py fast",
    "test:native:fast": "python3 scripts/workflow.py native --engine --fast",
    "test:proxy": "python3 scripts/workflow.py proxy",
    "test:rendering:unit": "python3 -m unittest discover -s tests/rendering -v",
    "demo:register": "bun demos/derpdesign/register.ts",
    "test:workspaces:engine": "python3 scripts/workflow.py build && python3 scripts/test-browser-layouts.py --workspaces",
    "test:layouts:engine": "python3 scripts/workflow.py build && python3 scripts/test-browser-layouts.py",
    "test:demos": "bun test demos/derpdesign/fixture.test.ts",
    "agent:mcp": "bun src/automation/server.ts",
    "test:agent": "python3 scripts/test-agent-browser.py",
    "test:agent:captures": "bun scripts/test-agent-captures.ts"
  },
  "dependencies": {
    "@effectweb/base-ui": "0.15.0",
    "@effectweb/lucide": "file:../EffectWeb/packages/lucide",
    "@effectweb/shadcn": "file:../EffectWeb/packages/shadcn",
    "@modelcontextprotocol/server": "^2.4.0",
    "colorjs.io": "0.7.1",
    "effect": "4.1.0",
    "effectweb": "file:../EffectWeb/packages/runtime",
    "less": "4.9.1",
    "postcss": "8.5.32",
    "stylus-lang-bundle": "github:openstyles/stylus-lang-bundle#ad941359ffd800eb6a16fa8459902573e7d5e240",
    "usercss-meta": "0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@derpdesign/harness": "file:../DerpDesign/packages/harness",
    "@effectweb/compiler": "file:../EffectWeb/packages/compiler",
    "@modelcontextprotocol/client": "^2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "patchedDependencies": {
    "@effectweb/base-ui@0.15.0": "patches/@effectweb%2Fbase-ui@0.15.0.patch",
    "vite@8.3.5": "patches/vite@8.3.5.patch"
  }
}
