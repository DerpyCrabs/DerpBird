+#[unsafe(no_mangle)]
+pub extern "C" fn rust_content_blocker_check_ip_address(
+    engine: Option<&ContentBlockerEngine>, url: ak::Span<'_, u8>, source: ak::Span<'_, u8>,
+    kind: ak::Span<'_, u8>, method: ak::Span<'_, u8>, address: ak::Span<'_, u8>, top: ak::Span<'_, u8>,
+) -> ContentBlockerDecision {
+    abort_on_panic(|| {
+        adblock::regex_manager::reset_host_regex_budget();
+        let (Some(engine), Some(url), Some(source), Some(kind), Some(method), Some(address)) =
+            (engine, as_str(url), as_str(source), as_str(kind), as_str(method), as_str(address))
+        else { return ContentBlockerDecision::allow(); };
+        if engine.ip_addresses.is_empty() { return ContentBlockerDecision::allow(); }
+        let top = as_str(top).filter(|value| !value.is_empty()).unwrap_or(source);
+        let Ok(request) = adblock::request::Request::new(url, source, kind, method).map(|request| request.with_top_url(top))
+        else { return ContentBlockerDecision::allow(); };
+        if matches!(engine.dynamic.check(&request, top), Some((adblock::dynamic_filtering::Action::Allow, _))) {
+            return ContentBlockerDecision::allow();
+        }
+        let exempt = engine.engine.check_network_request_subset(&request, false, true).exception.is_some();
+        let (blocked, rule) = engine.ip_addresses.check(&request, address, exempt);
+        ContentBlockerDecision { blocked, matched_rule: rule_to_ffi(rule), ..ContentBlockerDecision::allow() }
+    })
+}
