+bool WebContentView::set_browser_shell_overlay_image(QImage const& image, QPoint position)
+{
+    if (!m_page_surface || m_page_surface_failed)
+        return false;
+    using Kind = WaylandPageSurface::OverlayKind;
+    if (image.isNull()) {
+        m_page_surface->hide_overlay(Kind::BrowserShell);
+        m_browser_shell_overlay_image = {};
+        return true;
+    }
+    auto* parent = window()->windowHandle();
+    if (!parent || !current_paintable_can_use_vulkan_window())
+        return false;
+    auto window_position = mapTo(window(), position);
+    auto margins = parent->frameMargins();
+    auto surface_position = window_position + QPoint { margins.left(), margins.top() };
+    if (m_page_surface->is_overlay_showing(Kind::BrowserShell)
+        && m_browser_shell_overlay_image == image
+        && m_browser_shell_overlay_image.devicePixelRatio() == image.devicePixelRatio()
+        && m_browser_shell_overlay_position == surface_position)
+        return true;
+    if (!m_page_surface->show_overlay(*parent, image, window_position, Kind::BrowserShell))
+        return false;
+    m_browser_shell_overlay_image = image;
+    m_browser_shell_overlay_position = surface_position;
     return true;
 }
 
