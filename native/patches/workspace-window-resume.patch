+ErrorOr<Optional<RestoredSessionWindow>> SessionStore::resume_last_window()
+{
+    if (!m_last_window_to_resume.has_value() || m_transient_storage.window_count())
+        return Optional<RestoredSessionWindow> {};
+    auto id = *m_last_window_to_resume;
+    auto const& closed = m_transient_storage.closed_units();
+    if (!closed.find_first_index_if([&](auto const& unit) { return unit.session_id == id; }).has_value())
+        return Optional<RestoredSessionWindow> {};
+    if (m_persisted_storage.has_value())
+        TRY(m_persisted_storage->reopen_session(id));
+    auto unit = m_transient_storage.take_closed_unit(id).release_value();
+    m_last_window_to_resume.clear();
+    RestoredSessionWindow restored { .window_id = id, .tabs = {}, .active_tab_index = unit.active_tab_index, .geometry = unit.geometry };
+    m_transient_storage.open_window(id);
+    for (auto& tab : unit.tabs) {
+        restored.tabs.append({ .tab_id = tab.tab_id, .url = tab.active_url, .pinned = tab.pinned });
+        (void)m_transient_storage.open_tab(id, tab.tab_id, OpenTab { .window_id = id, .url = move(tab.active_url), .current_used_step_index = tab.current_used_step_index, .history = move(tab.history), .dirty = false, .pinned = tab.pinned });
+    }
+    if (auto index = index_as_size(unit.active_tab_index); index.has_value() && *index < restored.tabs.size())
+        m_transient_storage.set_active_tab(restored.tabs[*index].tab_id);
+    if (unit.geometry.has_value())
+        m_transient_storage.set_geometry(id, *unit.geometry);
+    if (on_closed_units_changed)
+        on_closed_units_changed();
+    return Optional<RestoredSessionWindow> { move(restored) };
+}
