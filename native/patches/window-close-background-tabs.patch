+                promise->resolve(Application::BookmarkDialogResult { .data = BookmarkItem::Bookmark { url.release_value(), move(name), move(favicon) }, .target_folder_id = move(folder) });
+            } else {
+                promise->reject(Error::from_errno(EINVAL));
+            }
+        });
+    return promise;
+}
