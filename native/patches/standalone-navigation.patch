+bool ViewImplementation::is_outside_app_scope(URL::URL const& url) const
+{
+    if (!m_app_scope.has_value() || !(url.scheme() == "http"sv || url.scheme() == "https"sv))
+        return false;
+    return !m_app_scope->origin().is_same_origin(url.origin()) || !url.serialize_path().starts_with(m_app_scope->serialize_path());
+}
