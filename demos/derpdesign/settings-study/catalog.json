{
  "config": [
    {
      "name": "debug.process.show_web_content_process_id",
      "title": "Show WebContent process ID in tab titles",
      "description": "Append the active WebContent process ID to each tab title and tooltip.",
      "type": "boolean",
      "defaultValue": false
    },
    {
      "name": "debug.ui.show_advanced_debug_menu",
      "title": "Show Debug menu",
      "description": "Show the Debug menu, with tools for inspecting Ladybird itself.",
      "type": "boolean",
      "defaultValue": false
    },
    {
      "name": "ui.toolbar.show_feedback_button",
      "title": "Show feedback button",
      "description": "Show the button for sending feedback at the end of the toolbar.",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "name": "ui.window.use_client_side_decorations",
      "title": "Use client-side window decorations",
      "description": "Use custom title bar and window controls instead of the system window frame.",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "name": "ui.tabs.vertical_tabs_hover_expand_delay_ms",
      "title": "Vertical tab hover expansion delay",
      "description": "Delay in milliseconds before collapsed vertical tabs begin expanding on hover. Set to 0 to expand immediately.",
      "type": "number",
      "defaultValue": 100
    },
    {
      "name": "ui.tabs.vertical_tabs_hover_expand_animation_duration_ms",
      "title": "Vertical tab hover expansion animation duration",
      "description": "Duration in milliseconds of the vertical tab hover expansion animation. Set to 0 to disable the animation.",
      "type": "number",
      "defaultValue": 100
    },
    {
      "name": "network.http_cache.maximum_size_mb",
      "title": "Maximum disk cache size",
      "description": "Limit the space used for the HTTP disk cache, in MiB.",
      "type": "number",
      "defaultValue": 5120
    },
    {
      "name": "downloads.maximum_connections_per_download",
      "title": "Maximum connections per download",
      "description": "Download a file over up to this many parallel connections when the server supports byte ranges. Set to 1 to always download over a single connection.",
      "type": "number",
      "defaultValue": 4
    },
    {
      "name": "downloads.split_without_validators",
      "title": "Split downloads without server validators",
      "description": "Allow multi-connection downloads even when the server sends no ETag or Last-Modified header, without which the browser cannot verify that every connection is being served the same file.",
      "type": "boolean",
      "defaultValue": false
    },
    {
      "name": "downloads.restart_stalled_connections",
      "title": "Restart stalled download connections",
      "description": "When one connection of a multi-connection download stops receiving data, drop it and request the rest of its byte range over a new connection.",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "name": "debug.compositor.disable_high_dynamic_range_surfaces",
      "title": "Disable HDR surfaces",
      "description": "Draw HDR content into the page tone-mapped to SDR, instead of letting the window server show it in high dynamic range.",
      "type": "boolean",
      "defaultValue": false
    },
    {
      "name": "updates.check_interval_minutes",
      "title": "Update check interval",
      "description": "How many minutes Ladybird waits after one check for a newer release before it checks again, while it checks for updates by itself. At least 5.",
      "type": "number",
      "defaultValue": 240
    }
  ],
